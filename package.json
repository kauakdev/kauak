{
  "name": "kauak",
  "version": "0.1.0",
  "description": "A Sims-style isometric office that shows what your Herdr coding agents are doing, live",
  "keywords": ["herdr", "coding-agents", "claude-code", "codex", "terminal", "multiplexer", "dashboard", "isometric", "pixijs"],
  "homepage": "https://github.com/agustinrbeltran/kauak#readme",
  "bugs": "https://github.com/agustinrbeltran/kauak/issues",
  "repository": { "type": "git", "url": "git+https://github.com/agustinrbeltran/kauak.git" },
  "license": "Apache-2.0",
  "author": "Agustin Renteria Beltran",
  "type": "module",
  "bin": { "kauak": "bin/kauak.js" },
  "exports": { "./package.json": "./package.json" },
  "files": ["bin", "cli", "bridge", "dist", "!**/*.test.*", "!**/fixtures", "!**/*.d.ts", "!dist/kauak-banner.png"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c blue,magenta \"node bridge/server.js\" \"vite\"",
    "bridge": "node bridge/server.js",
    "test": "node --test",
    "test:plugins": "node --test shared/plugins/registry.test.mjs",
    "web": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "start": "node bin/kauak.js serve",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm typecheck",
    "prepack": "npm run typecheck && npm run build",
    "verify:pack": "node scripts/verify-pack.js"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/ws": "^8.5.12",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.1.0",
    "pixi.js": "^8.6.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
