{
  "name": "kauak-workspace",
  "private": true,
  "description": "The Kauak repository: the npm package kauak and the workspace packages it is built from",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "concurrently -k -n bridge,web -c blue,magenta \"node packages/bridge/src/main.ts\" \"pnpm --filter @kauak/web dev\"",
    "bridge": "node packages/bridge/src/main.ts",
    "test": "pnpm -r test && node --test \"scripts/*.test.mjs\"",
    "test:plugins": "pnpm --filter @kauak/appearance test",
    "web": "pnpm --filter @kauak/web dev",
    "build": "pnpm -r build",
    "build:demo": "pnpm -r build:demo",
    "start": "node packages/kauak/bin/kauak.js serve",
    "typecheck": "pnpm -r typecheck",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm lint && pnpm check:boundaries && pnpm typecheck",
    "verify:pack": "node scripts/verify-pack.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "concurrently": "^9.1.0",
    "ws": "^8.18.0"
  }
}
